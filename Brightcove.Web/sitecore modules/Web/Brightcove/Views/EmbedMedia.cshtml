@using Sitecore.MediaFramework.Mvc
@using Sitecore.MediaFramework.Mvc.Extentions
@using Brightcove.Core.EmbedGenerator.Models

@model EmbedMarkup

@if (Model != null)
{

    <div class="brightcove-media-container">
        @Html.Raw(Model.Markup)
        @Html.Raw(Model.ScriptTag)
    </div>
}
else
{
    <div class='brightcove-media-container'><p>No media item is selected</p></div>
}